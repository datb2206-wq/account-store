# =============================================================
#  Copy file này thành .env rồi điền giá trị thật.
#  .env đã nằm trong .gitignore — KHÔNG commit.
# =============================================================

NODE_ENV=development

# ---------- PostgreSQL (docker-compose đọc các biến này) ----------
POSTGRES_USER=accszone
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=accszone
POSTGRES_PORT=5432
# Bộ nhớ PostgreSQL theo RAM của VPS (bảng trong deploy/README.md, mục "Tối ưu PostgreSQL").
# Mặc định hợp với VPS 2 GB. Đổi xong: docker compose ... up -d postgres
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
# Prisma dùng URL này. Nhớ đổi password cho khớp ở trên.
DATABASE_URL=postgresql://accszone:change_me_strong_password@localhost:5432/accszone?schema=public

# ---------- Redis (cache + BullMQ) ----------
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379
REDIS_URL=redis://:change_me_redis_password@localhost:6379

# ---------- Security ----------
# Sinh mỗi khóa 1 giá trị ngẫu nhiên KHÁC NHAU bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 32 bytes, base64 — dùng để mã hóa AES-256-GCM nội dung StockItem & API key Supplier.
# MẤT KHÓA NÀY = MẤT TOÀN BỘ DỮ LIỆU KHO. Backup cẩn thận.
ENCRYPTION_KEY=

# ---------- Uploads ----------
# Nơi lưu ảnh biên lai chuyển khoản (ngoài thư mục public, xem qua route có kiểm tra quyền).
# Để trống = <thư mục chạy web>/uploads. Docker đã đặt sẵn /app/uploads (volume "uploads").
UPLOAD_DIR=

# ---------- Seed Super Admin (chỉ dùng khi chạy pnpm db:seed) ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# ---------- Nạp tiền ----------
# Secret cho webhook ngân hàng (Casso/SePay...) gọi POST /api/webhooks/bank, header x-webhook-secret.
# Để trống = tắt duyệt tự động, admin duyệt tay. Sinh bằng lệnh randomBytes ở trên.
BANK_WEBHOOK_SECRET=
# Không bắt buộc. Có key thì TronGrid cho nhiều request hơn: https://www.trongrid.io
TRONGRID_API_KEY=
# Không bắt buộc. Mặc định dùng RPC công khai của BNB Chain.
BSC_RPC_URL=

# ---------- Worker (apps/worker) ----------
# Chu kỳ đồng bộ nhà cung cấp (phút)
SUPPLIER_SYNC_MINUTES=10
# Khoảng nghỉ giữa các trang catalog AccsZone (ms). Web gốc giới hạn 30 request/phút.
ACCSZONE_PAGE_DELAY_MS=2100
# Tự cập nhật tỷ giá currency.rates (giá quy đổi hiển thị + quy đổi nạp ngân hàng). Để trống = admin tự nhập.
# Nguồn trả JSON gốc USD dạng { rates: {...} }, VD https://open.er-api.com/v6/latest/USD
FX_RATES_URL=
FX_UPDATE_HOURS=6
# Tự phát hiện USDT BEP20 cần RPC hỗ trợ eth_getLogs (RPC công khai của BNB Chain thường chặn).
# Số block quét lùi khi worker khởi động, và số block mỗi lần gọi eth_getLogs.
BSC_SCAN_LOOKBACK_BLOCKS=2000
BSC_LOGS_CHUNK=500

# ---------- Production (xem deploy/README.md) ----------
# Docker Compose prod: cổng web trên máy chủ (Nginx proxy tới 127.0.0.1:WEB_PORT)
WEB_PORT=3000
# Số kết nối DB tối đa của mỗi tiến trình (web và worker mỗi bên 1 pool)
DB_POOL_SIZE=10
# Backup (deploy/scripts/backup-db.sh)
BACKUP_DIR=/var/backups/accszone
BACKUP_RETENTION_DAYS=14
# docker/docker-compose.prod.yml (Docker) | docker/docker-compose.yml (PM2)
BACKUP_COMPOSE_FILE=docker/docker-compose.prod.yml
BACKUP_RCLONE_REMOTE=
BACKUP_PING_URL=
