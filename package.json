{
  "name": "accszone",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "infra:up": "docker compose -f docker/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f docker/docker-compose.yml --env-file .env down",
    "infra:logs": "docker compose -f docker/docker-compose.yml --env-file .env logs -f",
    "db:generate": "pnpm --filter @accszone/database db:generate",
    "db:migrate": "pnpm --filter @accszone/database db:migrate",
    "db:deploy": "pnpm --filter @accszone/database db:deploy",
    "db:seed": "pnpm --filter @accszone/database db:seed",
    "db:studio": "pnpm --filter @accszone/database db:studio",
    "prod:up": "docker compose -f docker/docker-compose.prod.yml --env-file .env up -d --build",
    "prod:down": "docker compose -f docker/docker-compose.prod.yml --env-file .env down",
    "prod:logs": "docker compose -f docker/docker-compose.prod.yml --env-file .env logs -f --tail=200 web worker"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
