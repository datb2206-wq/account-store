// =============================================================
//  Account Store — Database Schema
//  DB: PostgreSQL (bắt buộc cho FOR UPDATE SKIP LOCKED)
//  Quy ước tiền tệ: mọi số tiền lưu bằng USD (base currency),
//  kiểu Decimal(18, 6) — KHÔNG BAO GIỜ dùng Float cho tiền.
// =============================================================

generator client {
  provider = "prisma-client-js"
  // native: máy dev/Docker; rhel-openssl-3.0.x: Vercel serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
//  ENUMS
// -------------------------------------------------------------

enum Role {
  USER
  STAFF
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  PENDING_VERIFY
}

enum Locale {
  en
  id
  ru
  zh
}

enum ProductSource {
  LOCAL // kho do mình tự nhập
  RESELLER // lấy hàng từ web gốc qua API
}

enum StockStatus {
  AVAILABLE
  RESERVED // đang giữ chỗ trong 1 giao dịch (hiếm khi tồn tại lâu)
  SOLD
  INVALID // admin đánh dấu hỏng / bị khóa
}

enum OrderStatus {
  PENDING // đã trừ tiền, chờ giao (đơn reseller đang xử lý ở queue)
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionType {
  DEPOSIT // nạp tiền
  PURCHASE // mua hàng (trừ tiền)
  REFUND // hoàn tiền
  ADJUSTMENT // admin cộng/trừ tay
  BONUS // tiền thưởng khuyến mãi nạp tiền
  COMMISSION // chuyển hoa hồng giới thiệu vào số dư
  SELLER // CTV chuyển tiền bán hàng vào số dư mua hàng
}

enum TransactionStatus {
  PENDING // chờ xác minh (USDT chờ confirmations / bank chờ admin duyệt)
  COMPLETED
  REJECTED
  EXPIRED
}

enum PaymentMethod {
  USDT_TRC20
  USDT_BEP20
  BANK_TRANSFER
  BALANCE // giao dịch nội bộ bằng số dư (mua hàng, hoàn tiền)
  MANUAL // admin điều chỉnh
  MOMO // chuyển MoMo (khách báo đã chuyển, admin duyệt / webhook)
  CUSTOM // phương thức nạp thủ công admin tự tạo (PayPal, Binance Pay…)
  CARD // thẻ cào điện thoại qua đối tác đổi thẻ
}

// -------------------------------------------------------------
//  USER
// -------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  username      String?    @unique
  passwordHash  String
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)

  // Số dư luôn tính bằng USD. Chỉ thay đổi qua câu lệnh
  // UPDATE có điều kiện trong DB transaction, kèm 1 bản ghi Transaction.
  balance       Decimal    @default(0) @db.Decimal(18, 6)

  locale        Locale     @default(en)
  currency      String     @default("USD") @db.VarChar(3) // tiền tệ hiển thị

  // API key cho khách hàng muốn mua qua API (lưu HASH, không lưu plain)
  apiKeyHash    String?    @unique
  twoFactorSecret String?  // mã hóa trước khi lưu

  // Vai trò quản trị (Admin > Admin Role). Chỉ áp dụng cho STAFF: null = quyền nhân viên mặc định
  adminRoleId   String?
  adminRole     AdminRole? @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)

  lastLoginAt   DateTime?
  lastLoginIp   String?
  // Affiliate: mã giới thiệu riêng, người đã giới thiệu mình, số dư hoa hồng (tách khỏi số dư mua hàng)
  referralCode  String?   @unique
  referredById  String?
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[]    @relation("Referrals")
  commissionBalance Decimal @default(0) @db.Decimal(18, 6)
  emailOptOut   Boolean   @default(false) // khách bấm "hủy nhận tin" trong email chiến dịch
  registerIp    String?   // IP lúc đăng ký: giới hạn số tài khoản / IP (Admin > Bảo mật)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  orders        Order[]
  seller        Seller?
  transactions  Transaction[]         @relation("UserTransactions")
  reviewedTxs   Transaction[]         @relation("ReviewedTransactions")
  auditLogs     AuditLog[]

  @@index([role])
  @@index([registerIp])
  @@index([referredById])
  @@map("users")
}

// -------------------------------------------------------------
//  CATALOG
// -------------------------------------------------------------

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  // Đa ngôn ngữ: { "en": "Twitter", "ru": "Твиттер", "zh": "推特", "id": "Twitter" }
  name        Json
  description Json?
  iconUrl     String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)

  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")

  // Đồng bộ từ web gốc
  supplierId  String?
  supplier    Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  externalId  String?

  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([supplierId, externalId])
  @@index([parentId, sortOrder])
  @@map("categories")
}

model Product {
  id           String        @id @default(cuid())
  slug         String        @unique
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name         Json          // i18n
  description  Json?         // i18n, có thể chứa định dạng giao hàng: "login:pass:email:emailpass"

  price        Decimal       @db.Decimal(18, 6) // giá bán (USD)
  costPrice    Decimal?      @db.Decimal(18, 6) // giá vốn (giá web gốc) — chỉ admin xem
  minQty       Int           @default(1)
  maxQty       Int           @default(1000)
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  isFeatured   Boolean       @default(false) // 📌 Nổi bật: lên đầu danh mục + hàng "Nổi bật" ở trang chủ

  source       ProductSource @default(LOCAL)
  supplierId   String?
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  externalId   String?       // ID sản phẩm bên web gốc
  externalStock Int?         // tồn kho bên web gốc (cập nhật bởi sync job)
  lastSyncedAt DateTime?

  stockItems   StockItem[]
  orders       Order[]
  // CTV: sản phẩm do người bán ngoài đăng, phải được admin duyệt mới hiện
  sellerId     String?
  seller       Seller?         @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  approval     ProductApproval @default(APPROVED)
  rejectReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([sellerId])
  @@unique([supplierId, externalId])
  @@index([categoryId, isActive, sortOrder])
  @@map("products")
}

// Mỗi dòng = 1 tài khoản cụ thể trong kho
model StockItem {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Dữ liệu tài khoản ĐƯỢC MÃ HÓA (AES-256-GCM) ở tầng ứng dụng
  content     String
  // SHA-256 của nội dung gốc -> chống nhập trùng cùng 1 tài khoản 2 lần
  contentHash String

  status      StockStatus @default(AVAILABLE)
  orderId     String?
  order       Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  soldAt      DateTime?

  importBatch String?     // mã lô nhập, tiện rollback 1 lô lỗi
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([productId, contentHash])
  // Index phục vụ câu SELECT ... WHERE product_id = ? AND status = 'AVAILABLE' FOR UPDATE SKIP LOCKED
  @@index([productId, status, createdAt])
  // Lấy hàng ngẫu nhiên: contentHash là HMAC nên phân bố đều, quét từ 1 điểm ngẫu nhiên thay cho ORDER BY random()
  @@index([productId, status, contentHash])
  @@index([orderId])
  @@map("stock_items")
}

// -------------------------------------------------------------
//  ORDERS
// -------------------------------------------------------------

model Order {
  id              String      @id @default(cuid())
  code            String      @unique // mã hiển thị cho khách, VD: ORD-20261027-8F3K2
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity        Int
  unitPrice       Decimal     @db.Decimal(18, 6) // snapshot giá lúc mua
  totalAmount     Decimal     @db.Decimal(18, 6)
  // Giá vốn 1 cái lúc mua (snapshot Product.costPrice) -> lãi = tiền thực thu − unitCost × quantity
  unitCost        Decimal?    @db.Decimal(18, 6)
  status          OrderStatus @default(PENDING)

  // Client gửi kèm header Idempotency-Key -> bấm "Mua" 2 lần không bị tạo 2 đơn
  idempotencyKey  String?     @unique

  // Đơn reseller
  supplierId      String?
  supplier        Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  externalOrderId String?
  failReason      String?

  // Mã giảm giá đã dùng: totalAmount là số tiền SAU giảm, discountAmount là phần được giảm
  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  discountAmount  Decimal     @default(0) @db.Decimal(18, 6)

  stockItems      StockItem[]
  transactions    Transaction[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([supplierId, externalOrderId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("orders")
}

// -------------------------------------------------------------
//  TRANSACTIONS (Sổ cái — ledger, chỉ INSERT, không sửa số tiền)
// -------------------------------------------------------------

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation("UserTransactions", fields: [userId], references: [id], onDelete: Restrict)

  type          TransactionType
  method        PaymentMethod
  status        TransactionStatus @default(PENDING)

  // amount > 0: cộng tiền, amount < 0: trừ tiền (USD)
  amount        Decimal           @db.Decimal(18, 6)
  balanceBefore Decimal?          @db.Decimal(18, 6) // ghi khi COMPLETED
  balanceAfter  Decimal?          @db.Decimal(18, 6)

  // Số tiền gốc theo đơn vị thanh toán (VD: 25.0037 USDT hoặc 500000 VND)
  originalAmount   Decimal?       @db.Decimal(24, 6)
  originalCurrency String?        @db.VarChar(10)
  exchangeRate     Decimal?       @db.Decimal(18, 8)

  // ---- USDT ----
  network       String?           // "TRC20" | "BEP20"
  txHash        String?           // TxID on-chain, lưu dạng lowercase, đã trim
  fromAddress   String?
  toAddress     String?
  confirmations Int?

  // ---- Bank ----
  // Nội dung chuyển khoản duy nhất, VD: "NAP 8F3K2" -> map 1-1 với yêu cầu nạp
  transferCode  String?           @unique
  bankRef       String?           // mã giao dịch ngân hàng (khi gắn API tự động)
  proofImageUrl String?           // khóa file biên lai trong UPLOAD_DIR (VD "proofs/abc.jpg"), xem qua /api/deposits/[id]/proof
  claimedAt     DateTime?         // khách bấm "Tôi đã chuyển khoản" -> chờ admin duyệt, không tự hết hạn nữa
  // Mã giao dịch do KHÁCH tự khai, chưa xác minh -> tách khỏi bankRef (unique, chỉ admin/webhook ghi)
  // để không ai "giữ chỗ" được mã ngân hàng của người khác.
  customerRef   String?

  // ---- Thẻ cào ----
  cardTelco     String?
  cardSerial    String?
  cardCode      String?           // mã thẻ ĐÃ MÃ HÓA (AES-256-GCM)
  cardHash      String?           @unique // HMAC(telco:serial:code) -> 1 thẻ chỉ gửi được 1 lần

  orderId       String?
  order         Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Admin duyệt / điều chỉnh
  reviewedById  String?
  reviewedBy    User?             @relation("ReviewedTransactions", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  note          String?

  expiresAt     DateTime?         // yêu cầu nạp hết hạn sau X phút
  metadata      Json?             // raw response từ blockchain API / bank API
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // CHỐNG DOUBLE-SPENDING: 1 TxID trên 1 mạng chỉ được ghi nhận DUY NHẤT 1 LẦN.
  // (Postgres cho phép nhiều NULL trong unique -> không ảnh hưởng giao dịch không phải crypto)
  @@unique([network, txHash])
  @@unique([method, bankRef])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type, status])
  @@index([orderId])
  @@index([customerRef])
  @@map("transactions")
}

// -------------------------------------------------------------
//  SUPPLIER (Web gốc cho Reseller API)
// -------------------------------------------------------------

model Supplier {
  id           String     @id @default(cuid())
  name         String
  baseUrl      String
  apiKeyEnc    String     // API key MÃ HÓA
  adapter      String     @default("generic") // định dạng API của web gốc: "generic" | "accszone"
  priceMarkup  Decimal    @default(1.2) @db.Decimal(8, 4) // giá bán = giá gốc * markup
  autoUpdatePrice Boolean @default(true)  // mỗi lần đồng bộ tính lại giá bán theo giá gốc mới
  priceRounding   String  @default("none") // làm tròn LÊN giá bán: "none" | "0.01" | "0.1" | "1"
  autoUpdateInfo  Boolean @default(false) // ghi đè tên & mô tả (tiếng Anh) theo nguồn mỗi lần đồng bộ
  stripHtml       Boolean @default(true)  // lọc thẻ HTML khỏi tên & mô tả lấy từ nguồn
  isActive     Boolean    @default(true)
  lastSyncAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  categories   Category[]
  products     Product[]
  orders       Order[]

  @@map("suppliers")
}

// -------------------------------------------------------------
//  SYSTEM CONFIG & AUDIT
// -------------------------------------------------------------

// Key-value config chỉnh được từ Admin Panel, cache trong Redis.
// VD: key="usdt.trc20.wallet", "usdt.min_confirmations", "rates.VND", "bank.accounts"
model SystemConfig {
  key         String   @id
  value       Json
  isSecret    Boolean  @default(false) // true -> không trả về cho frontend
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

// Ghi lại mọi hành động của Staff/Admin (duyệt nạp, sửa số dư, nhập kho...)
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // VD: "transaction.approve", "user.balance.adjust"
  entity    String   // VD: "Transaction"
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// -------------------------------------------------------------
//  MARKETING: mã giảm giá, khuyến mãi nạp tiền
// -------------------------------------------------------------

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique // luôn lưu IN HOA
  discountPercent Decimal   @db.Decimal(5, 2) // 0 < x <= 100
  maxDiscount     Decimal?  @db.Decimal(18, 6) // giảm tối đa (USD), null = không giới hạn
  minOrder        Decimal?  @db.Decimal(18, 6) // giá trị đơn tối thiểu (USD)
  productIds      String[]  // rỗng = áp dụng mọi sản phẩm
  maxUses         Int       // tổng số lượt dùng
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  orders          Order[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("coupons")
}

// Nạp từ minAmount (USD) trở lên được thưởng thêm bonusPercent % (lấy mốc cao nhất đạt được)
model DepositBonus {
  id           String   @id @default(cuid())
  minAmount    Decimal  @unique @db.Decimal(18, 6)
  bonusPercent Decimal  @db.Decimal(5, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("deposit_bonuses")
}

// -------------------------------------------------------------
//  BẢO MẬT: chặn IP
// -------------------------------------------------------------

model BlockedIp {
  id          String    @id @default(cuid())
  ip          String    @unique
  reason      String
  attempts    Int       @default(0) // số lần đăng nhập sai khi bị chặn tự động
  expiresAt   DateTime? // null = chặn vĩnh viễn
  createdById String?   // null = hệ thống tự chặn
  createdAt   DateTime  @default(now())

  @@map("blocked_ips")
}

// -------------------------------------------------------------
//  BLOG
// -------------------------------------------------------------

model BlogCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  posts     BlogPost[]
  createdAt DateTime   @default(now())

  @@map("blog_categories")
}

model BlogPost {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  content     String        // văn bản thường: "## " = tiêu đề, "- " = gạch đầu dòng, dòng trống = đoạn mới
  coverUrl    String?
  categoryId  String?
  category    BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isPublished Boolean       @default(true)
  views       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isPublished, createdAt(sort: Desc)])
  @@map("blog_posts")
}

// -------------------------------------------------------------
//  GIAO DIỆN
// -------------------------------------------------------------

// Ảnh giao diện admin tải lên (logo, favicon, banner...). Lưu thẳng trong DB vì máy chủ dạng serverless
// (Vercel) không giữ file ghi ra ổ đĩa. Ảnh nhỏ (giới hạn ở web), phục vụ qua /api/assets/[key] có cache.
model SiteAsset {
  key       String   @id // logo | logoDark | favicon | ogImage | banner | productDefault | avatar
  data      Bytes
  mime      String
  size      Int
  updatedAt DateTime @updatedAt

  @@map("site_assets")
}

// File khách tải lên (ảnh biên lai chuyển khoản). Lưu trong DB vì máy chủ serverless không giữ file trên ổ đĩa.
// key giữ định dạng cũ "proofs/<uuid>.<ext>" để các yêu cầu nạp đã có vẫn trỏ đúng.
model UploadedFile {
  key       String   @id
  data      Bytes
  mime      String
  size      Int
  createdAt DateTime @default(now())

  @@map("uploaded_files")
}

// Vai trò quản trị: tập quyền (VD "orders.view") gán cho nhân viên. Danh sách quyền ở apps/web/src/lib/permissions.ts
model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]

  @@map("admin_roles")
}

// Công việc tự động (Admin > Tự động hóa): worker chạy định kỳ, dọn dữ liệu cũ hơn olderThanSec giây.
// type: "sold_stock" | "invalid_stock" | "audit_logs" | "stale_deposits" (xem packages/core/src/automations.ts)
model AutomationTask {
  id          String    @id @default(cuid())
  name        String
  type        String
  olderThanSec Int
  isActive    Boolean   @default(true)
  lastRunAt   DateTime?
  lastResult  String?   // VD "Đã xóa 120 tài khoản" hoặc lỗi
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("automation_tasks")
}

// Chiến dịch email hàng loạt (Admin > Email Campaigns). Worker gửi dần theo đợt, nhớ vị trí bằng cursor (id user cuối đã gửi).
// recipients: "all" = mọi thành viên đang hoạt động chưa hủy nhận tin; "list" = danh sách email trong emails
model EmailCampaign {
  id         String   @id @default(cuid())
  name       String
  subject    String
  body       String   // HTML
  recipients String   @default("all")
  emails     String[]
  cc         String   @default("")
  bcc        String   @default("")
  status     String   @default("SENDING") // SENDING | PAUSED | DONE
  total      Int      @default(0)
  sent       Int      @default(0)
  failed     Int      @default(0)
  cursor     String?
  siteUrl    String   @default("") // gốc URL web lúc tạo chiến dịch -> link hủy nhận tin trong email
  lastError  String?
  createdById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@map("email_campaigns")
}

// Hoa hồng: 1 dòng / đơn hàng của người được giới thiệu. REVERSED = đơn bị hoàn tiền, đã trừ lại hoa hồng.
model AffiliateCommission {
  id          String   @id @default(cuid())
  referrerId  String   // người nhận hoa hồng
  buyerId     String   // người được giới thiệu (người mua)
  orderId     String   @unique
  orderAmount Decimal  @db.Decimal(18, 6)
  percent     Decimal  @db.Decimal(6, 3)
  amount      Decimal  @db.Decimal(18, 6)
  status      String   @default("CREDITED") // CREDITED | REVERSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([referrerId, createdAt(sort: Desc)])
  @@map("affiliate_commissions")
}

// Rút hoa hồng. method "balance" = chuyển vào số dư (hoàn tất ngay); "bank" = admin duyệt rồi chuyển khoản tay.
model AffiliateWithdrawal {
  id          String    @id @default(cuid())
  userId      String
  amount      Decimal   @db.Decimal(18, 6)
  method      String    // balance | bank
  bankName    String    @default("")
  accountNo   String    @default("")
  accountName String    @default("")
  status      String    @default("PENDING") // PENDING | COMPLETED | REJECTED
  note        String    @default("")
  reviewedById String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("affiliate_withdrawals")
}

// -------------------------------------------------------------
//  CTV (người bán ngoài đăng bán hàng trên web)
// -------------------------------------------------------------
enum SellerStatus {
  PENDING // đã đăng ký, chờ admin duyệt
  ACTIVE
  SUSPENDED // tạm khóa: sản phẩm bị ẩn, không rút tiền
  REJECTED
}

enum ProductApproval {
  APPROVED
  PENDING
  REJECTED
}

model Seller {
  id                String       @id @default(cuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName          String
  contact           String       @default("") // Telegram / Zalo để admin liên hệ
  intro             String       @default("") // giới thiệu hàng sẽ bán (lúc đăng ký)
  status            SellerStatus @default(PENDING)
  commissionPercent Decimal?     @db.Decimal(5, 2) // phí sàn riêng cho CTV này; null = mặc định
  balance           Decimal      @default(0) @db.Decimal(18, 6) // tiền bán hàng có thể rút (có thể âm khi đơn bị hoàn sau khi đã rút)
  adminNote         String       @default("")
  approvedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  products    Product[]
  earnings    SellerEarning[]
  withdrawals SellerWithdrawal[]

  @@index([status])
  @@map("sellers")
}

// Tiền CTV nhận từ 1 đơn: (tiền thực thu − hoàn) × (100 − phí sàn)%. HOLD đến releaseAt rồi mới vào số dư.
model SellerEarning {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderId     String   @unique
  orderAmount Decimal  @db.Decimal(18, 6)
  feePercent  Decimal  @db.Decimal(5, 2)
  amount      Decimal  @db.Decimal(18, 6)
  status      String   @default("HOLD") // HOLD | AVAILABLE | REVERSED
  releaseAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerId, createdAt(sort: Desc)])
  @@index([status, releaseAt])
  @@map("seller_earnings")
}

model SellerWithdrawal {
  id           String    @id @default(cuid())
  sellerId     String
  seller       Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount       Decimal   @db.Decimal(18, 6)
  method       String // balance | bank
  bankName     String    @default("")
  accountNo    String    @default("")
  accountName  String    @default("")
  status       String    @default("PENDING") // PENDING | COMPLETED | REJECTED
  note         String    @default("")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([sellerId, createdAt(sort: Desc)])
  @@index([status])
  @@map("seller_withdrawals")
}
